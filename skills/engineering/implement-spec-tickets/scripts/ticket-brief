#!/usr/bin/env bash
# Write one ticket's full text to a git-internal brief file so subagents read
# requirements from disk instead of receiving large pasted prompts.
#
# Usage: ticket-brief --tracker github|gitlab|local TICKET_REF [OUTFILE]
set -euo pipefail

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ] || [ "$1" != "--tracker" ]; then
  echo "usage: ticket-brief --tracker github|gitlab|local TICKET_REF [OUTFILE]" >&2
  exit 2
fi

tracker=$2
ref=$3

case "$tracker" in
  github|gitlab|local) ;;
  *)
    echo "unsupported tracker: $tracker (expected github, gitlab, or local)" >&2
    exit 2
    ;;
esac

sanitize_ref() {
  printf '%s' "$1" | tr -cs 'A-Za-z0-9._-' '-'
}

if [ "$#" -eq 4 ]; then
  out=$4
else
  dir=$(git rev-parse --git-path implement-spec-tickets)
  mkdir -p "$dir"
  dir=$(cd "$dir" && pwd)
  id=$(sanitize_ref "$ref")
  out="$dir/ticket-${id}-brief.md"
fi

write_header() {
  echo "# Ticket Brief"
  echo
  echo "Source: $ref"
  echo "Fetched at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo
}

if [ "$tracker" = "local" ]; then
  [ -f "$ref" ] || {
    echo "local ticket file not found: $ref" >&2
    exit 3
  }

  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "local tickets require a Git repository" >&2
    exit 3
  }
  abs=$(cd "$(dirname "$ref")" && pwd)/$(basename "$ref")
  relative=${abs#"$root"/}
  if [[ ! "$relative" =~ ^\.scratch/[^/]+/issues/[0-9]{2,}-[^/]+\.md$ ]]; then
    echo "unsupported local ticket path: $ref" >&2
    echo "expected .scratch/<feature>/issues/<NN>-<slug>.md" >&2
    exit 3
  fi

  {
    write_header
    echo "Local path: $abs"
    echo
    echo "## Ticket"
    echo
    cat "$ref"
  } > "$out"
  echo "wrote $out"
  exit 0
fi

if [ "$tracker" = "github" ]; then
  command -v gh >/dev/null 2>&1 || {
    echo "gh is required for GitHub ticket refs: $ref" >&2
    exit 4
  }

  repo_args=()
  target=""

  if [[ "$ref" =~ ^https://github\.com/([^/]+/[^/]+)/issues/([0-9]+) ]]; then
    repo_args=(--repo "${BASH_REMATCH[1]}")
    target="${BASH_REMATCH[2]}"
  elif [[ "$ref" =~ ^([^/#[:space:]]+/[^/#[:space:]]+)#([0-9]+)$ ]]; then
    repo_args=(--repo "${BASH_REMATCH[1]}")
    target="${BASH_REMATCH[2]}"
  elif [[ "$ref" =~ ^#([0-9]+)$ ]]; then
    target="${BASH_REMATCH[1]}"
  elif [[ "$ref" =~ ^([0-9]+)$ ]]; then
    target="${BASH_REMATCH[1]}"
  else
    echo "unsupported GitHub ticket ref: $ref" >&2
    exit 3
  fi

  {
    write_header
    echo "## Ticket"
    echo
    gh issue view "$target" "${repo_args[@]}"
  } > "$out"

  echo "wrote $out"
  exit 0
fi

if [ "$tracker" = "gitlab" ]; then
  command -v glab >/dev/null 2>&1 || {
    echo "glab is required for GitLab ticket refs: $ref" >&2
    exit 4
  }

  target=""
  if [[ "$ref" =~ ^https?://.+/-/issues/[0-9]+$ ]]; then
    target="$ref"
  elif [[ "$ref" =~ ^#([0-9]+)$ ]]; then
    target="${BASH_REMATCH[1]}"
  elif [[ "$ref" =~ ^([0-9]+)$ ]]; then
    target="${BASH_REMATCH[1]}"
  else
    echo "unsupported GitLab ticket ref: $ref" >&2
    exit 3
  fi

  {
    write_header
    echo "## Ticket"
    echo
    glab issue view "$target"
  } > "$out"

  echo "wrote $out"
  exit 0
fi

echo "unsupported tracker: $tracker" >&2
exit 2
